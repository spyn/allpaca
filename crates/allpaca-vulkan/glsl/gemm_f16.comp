#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform Push {
    uint m;
    uint n;
    uint k;
    uint _pad;
} dims;

layout(std430, set = 0, binding = 0) readonly buffer A { float a[]; };
layout(std430, set = 0, binding = 1) readonly buffer B { uint b[]; };
layout(std430, set = 0, binding = 2) buffer C { float c[]; };

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    if (row >= dims.m || col >= dims.n) {
        return;
    }
    float acc = 0.0;
    for (uint kk = 0u; kk < dims.k; kk++) {
        float av = a[row * dims.k + kk];
        uint elem = col * dims.k + kk;
        uint word = b[elem >> 1u];
        vec2 hv = unpackHalf2x16(word);
        float bv = ((elem & 1u) == 0u) ? hv.x : hv.y;
        acc += float(float16_t(av) * float16_t(bv));
    }
    c[row * dims.n + col] = acc;
}
